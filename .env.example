# Database
DATABASE_URL=postgresql://rag:rag@localhost:5434/rag

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# LLM provider (Phase 4 — provider choice TBD)
# TODO: set provider and API key once Phase 4 provider is selected
LLM_PROVIDER=
LLM_API_KEY=

# Embedding provider — OpenAI text-embedding-3-small (ADR 0002, 1536 dims)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# OCR tuning (worker)
OCR_CONCURRENCY=2
MAX_PAGES_PER_OCR_JOB=50
TESSERACT_LANG=eng

# App ports (use 3010 if something else already listens on 3000)
API_PORT=3001
WEB_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3010
